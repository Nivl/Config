  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/melvin/.melvin/config/shared_config/.claude/hooks/gh-api-write-guard.py",
            "if": "Bash(gh api *)"
          },
          {
            "type": "command",
            "command": "/Users/melvin/.melvin/config/shared_config/.claude/hooks/gh-api-write-guard.py",
            "if": "Bash(/opt/homebrew/bin/gh api *)"
          },
          {
            "type": "command",
            "command": "/Users/melvin/.melvin/config/shared_config/.claude/hooks/cd-under-roots.py",
            "if": "Bash(cd *)"
          },
          {
            "type": "command",
            "command": "/Users/melvin/.melvin/config/shared_config/.claude/hooks/git-safe-subcommands.py",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "/Users/melvin/.melvin/config/shared_config/.claude/hooks/git-safe-subcommands.py",
            "if": "Bash(/usr/bin/git *)"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/melvin/.melvin/config/shared_config/.claude/hooks/write-under-roots.py"
          }
        ]
      }
    ]
